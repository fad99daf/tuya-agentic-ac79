+ * type: 0=正在升级(OtaInUpdate.mp3) 1=升级成功(OtaSuccess.mp3) 2=升级失败(OtaFailed.mp3) */
+void app_music_play_ota_prompt(int type)
+{
+    const char *fname = "OtaInUpdate.mp3";
+    if (type == 1) {
+        fname = "OtaSuccess.mp3";
+    } else if (type == 2) {
+        fname = "OtaFailed.mp3";
+    }
+    app_music_play_voice_prompt(fname, NULL);
+}
