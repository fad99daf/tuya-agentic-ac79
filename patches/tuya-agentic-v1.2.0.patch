 static int recorder_vfs_fwrite(void *file, void *data, unsigned int len)
 {
-    static int cnt;
-    int ret;
     cbuffer_t *cbuf = (cbuffer_t *)file;
 
+#if defined(CONFIG_TUYA_AGENTIC_ENABLE)
+    /* 录音 cbuf 满时保留最新话音。旧逻辑 write=0 就 clear 全缓冲，TTS 期间 cbuf
